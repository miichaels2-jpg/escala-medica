{
  "buildCommand": "npm test && npm run build",
  "rewrites": [
    {
      "source": "/((?!assets/|icons/|manual/|cartas/|tutoriais/).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
