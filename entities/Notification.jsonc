{
  "name": "Notification",
  "type": "object",
  "properties": {
    "professional_id": {
      "type": "string"
    },
    "professional_name": {
      "type": "string"
    },
    "shift_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "nova_escala",
        "alteracao",
        "troca",
        "cancelamento"
      ],
      "default": "nova_escala"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "company_id": {
      "type": "string"
    }
  },
  "required": [
    "professional_id",
    "title",
    "company_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.company_id": "{{user.data.company_id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.company_id": "{{user.data.company_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.company_id": "{{user.data.company_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.company_id": "{{user.data.company_id}}"
        }
      ]
    }
  }
}