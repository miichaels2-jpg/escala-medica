{
  "name": "ShiftSwap",
  "type": "object",
  "properties": {
    "shift_id": {
      "type": "string"
    },
    "shift_date": {
      "type": "string",
      "format": "date"
    },
    "requester_id": {
      "type": "string",
      "description": "ID do profissional que solicitou a troca"
    },
    "requester_name": {
      "type": "string"
    },
    "target_id": {
      "type": "string",
      "description": "ID do profissional que receberia a troca"
    },
    "target_name": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovada",
        "rejeitada",
        "cancelada"
      ],
      "default": "pendente"
    },
    "company_id": {
      "type": "string"
    },
    "unit_id": {
      "type": "string",
      "description": "Hospital/unidade da troca"
    }
  },
  "required": [
    "shift_id",
    "requester_id",
    "company_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.company_id": "{{user.data.company_id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.company_id": "{{user.data.company_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.company_id": "{{user.data.company_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.company_id": "{{user.data.company_id}}"
        }
      ]
    }
  }
}